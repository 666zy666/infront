.search-container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-top: 140rpx; /* 给固定搜索栏留出足够空间 */
}

.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333 !important;
  margin-right: 20rpx;
  z-index: 10000;
  opacity: 1;
}



.search-btn {
  background: #ff5000;
  color: white;
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  z-index: 10000;
}

.history-section, .suggest-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.clear-history {
  color: #ff5000;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
}

.history-tag, .suggest-item {
  background: #f5f5f5;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  margin: 10rpx 20rpx 10rpx 0;
  font-size: 28rpx;
  color: #333;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
}

.picker {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 10rpx;
}

.reset-btn {
  background: #ff5000;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.result-scroll {
  height: calc(100vh - 180rpx);
  margin-top: 20rpx;
}

.empty-result {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

.empty-result image {
  width: 400rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  justify-content: space-between;
}

.product-item {
  width: 48%;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.product-img {
  width: 100%;
  height: 320rpx;
}

.product-info {
  padding: 20rpx;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price {
  color: #ff5000;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.location {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}
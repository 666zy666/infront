.search-container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-top: 140rpx;
}

.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
  z-index: 10000;
  opacity: 1;
}

.clear-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #eee;
  border-radius: 50%;
  margin-right: 20rpx;
  font-size: 36rpx;
  color: #666;
  z-index: 10000;
}

.search-btn {
  background: #ff5000;
  color: white;
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  z-index: 10000;
}

.history-section, .suggest-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.clear-history {
  color: #ff5000;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
}

.history-tag, .suggest-item {
  background: #f5f5f5;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  margin: 10rpx 20rpx 10rpx 0;
  font-size: 28rpx;
  color: #333;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.picker {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 10rpx;
}

.reset-btn {
  background: #ff5000;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}

.result-scroll {
  height: calc(100vh - 180rpx);
}

.empty-result {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

.empty-result image {
  width: 400rpx;
}

 .product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  justify-content: space-between;
  min-height: 400rpx; /* 防止空时塌陷 */
} 
.product-item {
  width: 48%;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  transition: all 0.3s;
}
.product-img {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0; /* 占位背景，避免白块 */
}


.product-info {
  padding: 20rpx;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 42rpx;
}

.price {
  color: #ff5000;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.location {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
}

.empty-result {
  text-align: center;
  padding: 200rpx 40rpx;
  color: #999;
}

.empty-text {
  font-size: 36rpx;
  margin: 40rpx 0 20rpx;
}

.empty-tip {
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 32rpx;
}
/* pages/search/search.wxss */
.search-bar {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  align-items: center;
}
.search-bar input {
  flex: 1;
  background: #f5f5f5;
  padding: 16rpx 30rpx;
  border-radius: 50rpx;
  margin-right: 20rpx;
}
.filter-btn {
  margin-left: 20rpx;
  color: #1296db;
  font-size: 32rpx;
}

.filter-panel {
  background: #fff;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.filter-title text {
  float: right;
  color: #1296db;
}
.filter-item {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}
.filter-item text:first-child {
  width: 180rpx;
}

.product-grid {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.product-card image {
  width: 100%;
  height: 300rpx;
}
.info {
  padding: 20rpx;
}
.title {
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.price {
  color: #ff5000;
  font-size: 36rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
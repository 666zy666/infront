<view class="search-container">
  <!-- 搜索栏（固定顶部） -->
  <view class="search-bar">
    <input 
      placeholder="搜索设备、品牌、型号..." 
      value="{{keyword}}" 
      bindinput="onInput" 
      bindconfirm="onSearch" 
      confirm-type="search"
      focus="{{inputFocus}}" 
      cursor-spacing="220"
      adjust-position="true"
      hold-keyboard="false"
      class="search-input"
    />
    
    <button bindtap="onSearch" class="search-btn">搜索</button>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!searchMode && history.length > 0}}">
    <view class="section-header">
      <text>搜索历史</text>
      <text bindtap="clearHistory" class="clear-history">清空</text>
    </view>
    <view class="history-tags">
      <block wx:for="{{history}}" wx:key="*this">
        <view class="history-tag" bindtap="useHistory" data-keyword="{{item}}">
          {{item}}
        </view>
      </block>
    </view>
  </view>

  <!-- 搜索建议 -->
  <view class="suggest-section" wx:if="{{keyword && suggestList.length > 0 && !searchMode}}">
    <block wx:for="{{suggestList}}" wx:key="*this">
      <view class="suggest-item" bindtap="useSuggest" data-keyword="{{item}}">
        {{item}}
      </view>
    </block>
  </view>

  <!-- 筛选条件 -->
  <view class="filter-bar" wx:if="{{searchMode}}">
    <picker 
      bindchange="onCategoryChange" 
      value="{{categoryIndex}}" 
      range-key="name" 
      range="{{categories}}"
    >
      <view class="picker">分类：{{categories[categoryIndex].name || '全部'}}</view>
    </picker>

    <picker 
      bindchange="onSortChange" 
      value="{{sortIndex}}" 
      range="{{sortOptions}}"
    >
      <view class="picker">排序：{{sortOptions[sortIndex]}}</view>
    </picker>

    <button bindtap="resetFilter" class="reset-btn">重置</button>
  </view>
 
  <!-- 搜索结果 -->
  <scroll-view scroll-y class="result-scroll" wx:if="{{searchMode}}">
  <!-- 空结果 -->
  <view wx:if="{{products.length === 0 && !loading}}" class="empty-result">
    <image src="/images/empty-search.png" mode="widthFix" />
    <text>暂无匹配结果</text>
  </view>

  <!-- 商品列表 -->
  <view class="product-grid" wx:if="{{products.length > 0}}">
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-item" bindtap="toDetail" data-id="{{item.id}}">
        <image 
          src="{{item.images && item.images.length > 0 ? item.images[0].image : '/images/default.jpg'}}" 
          mode="aspectFill" 
          class="product-img"
        />
        <view class="product-info">
          <text class="title">{{item.title}}</text>
          <text class="price">¥{{item.price}}</text>
          <text class="location">{{item.location_province || '未知地区'}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
</scroll-view>
</view>
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.form { }

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.form-group.error {
  border-color: #ff4d4f;
  background: #fff5f5;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.input {
  font-size: 32rpx;
  color: #333;
  width: 100%;
  border: none;
  outline: none;
}

.textarea {
  font-size: 32rpx;
  color: #333;
  width: 100%;
  min-height: 120rpx;
  border: none;
  outline: none;
}

.switch-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-group .label { margin-bottom: 0; }

.error-text {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-top: 8rpx;
  display: block;
}

.save-btn {
  width: 100%;
  background: #1296db;
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

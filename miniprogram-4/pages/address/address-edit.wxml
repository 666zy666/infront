<view class="container">
  <view class="form">
    <!-- 收件人 -->
    <view class="form-group {{errors.name ? 'error' : ''}}">
      <text class="label">收件人 *</text>
      <input
        value="{{form.name}}"
        bindinput="inputChange"
        data-field="name"
        placeholder="请输入收件人姓名"
        class="input"
      />
      <text wx:if="{{errors.name}}" class="error-text">{{errors.name}}</text>
    </view>

    <!-- 手机号 -->
    <view class="form-group {{errors.phone ? 'error' : ''}}">
      <text class="label">手机号 *</text>
      <input
        value="{{form.phone}}"
        bindinput="inputChange"
        data-field="phone"
        placeholder="请输入手机号"
        type="number"
        class="input"
      />
      <text wx:if="{{errors.phone}}" class="error-text">{{errors.phone}}</text>
    </view>

    <!-- 省份 -->
    <view class="form-group">
      <text class="label">省份</text>
      <input
        value="{{form.province}}"
        bindinput="inputChange"
        data-field="province"
        placeholder="请输入省份（可选）"
        class="input"
      />
    </view>

    <!-- 城市 -->
    <view class="form-group">
      <text class="label">城市</text>
      <input
        value="{{form.city}}"
        bindinput="inputChange"
        data-field="city"
        placeholder="请输入城市（可选）"
        class="input"
      />
    </view>

    <!-- 区县 -->
    <view class="form-group">
      <text class="label">区县</text>
      <input
        value="{{form.district}}"
        bindinput="inputChange"
        data-field="district"
        placeholder="请输入区县（可选）"
        class="input"
      />
    </view>

    <!-- 详细地址 -->
    <view class="form-group {{errors.detail ? 'error' : ''}}">
      <text class="label">详细地址 *</text>
      <textarea
        value="{{form.detail}}"
        bindinput="inputChange"
        data-field="detail"
        placeholder="请输入街道门牌号等详细地址"
        class="textarea"
        auto-height
      />
      <text wx:if="{{errors.detail}}" class="error-text">{{errors.detail}}</text>
    </view>

    <!-- 设为默认 -->
    <view class="form-group switch-group">
      <text class="label">设为默认地址</text>
      <switch checked="{{form.is_default}}" bindchange="toggleDefault" color="#1296db" />
    </view>

    <button class="save-btn" bindtap="save" loading="{{saving}}">保存</button>
  </view>
</view>

.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.addr-list { padding: 20rpx; }

.addr-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.addr-top { margin-bottom: 20rpx; }

.addr-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.addr-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.addr-phone {
  font-size: 30rpx;
  color: #666;
  margin-right: 16rpx;
}

.default-tag {
  background: #1296db;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.addr-detail {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.addr-actions {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
  gap: 30rpx;
}

.action-btn {
  font-size: 28rpx;
  color: #1296db;
}

.action-btn.danger { color: #ff4d4f; }

.empty {
  text-align: center;
  padding: 120rpx 0 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  display: block;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 30rpx;
}

.add-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.add-btn {
  width: 100%;
  background: #1296db;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx;
}

/* pages/my-publish/my-publish.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: #fff;
  padding: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.list {
  padding: 0 20rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.item image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.info {
  flex: 1;
  overflow: hidden;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  font-size: 34rpx;
  color: #ff5000;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.status {
  font-size: 26rpx;
  color: #07c160;
  display: block;
}

.status.offline {
  color: #999;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
}

.actions button {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 50rpx;
  line-height: 1.4;
  margin: 0;
}

.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #999;
  font-size: 30rpx;
}
<view class="container">
  <!-- 图片轮播 -->
  <swiper indicator-dots autoplay circular interval="3000" duration="500">
    <block wx:for="{{images}}" wx:key="id">
      <swiper-item>
        <image src="{{item.image}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.image}}" />
      </swiper-item>
    </block>
  </swiper>

  <!-- 价格与标题 + 收藏按钮 -->
  <view class="info">
    <view class="title-section">
      <view class="title-price">
        <view class="price">¥{{product.price}}</view>
        <view class="title">{{product.title}}</view>
      </view>
      
      <!-- 新增：收藏按钮 -->
      <view class="favorite-btn" bindtap="toggleFavorite">
        <image 
          src="{{isFavorited ? '/images/favorite-filled.png' : '/images/favorite-empty.png'}}" 
          mode="aspectFit" 
          class="favorite-icon"
        />
        <text class="favorite-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
  </view>

  <!-- 参数列表 -->
  <view class="params">
    <view class="param">
      <text class="label">设备类型</text>
      <text class="value">{{product.machinery_type}}</text>
    </view>
    <view class="param">
      <text class="label">品牌</text>
      <text class="value">{{product.brand || '未填写'}}</text>
    </view>
    <view class="param">
      <text class="label">型号</text>
      <text class="value">{{product.model_number || '未填写'}}</text>
    </view>
    <view class="param">
      <text class="label">出厂年份</text>
      <text class="value">{{product.manufacture_year || '未填写'}}</text>
    </view>
    <view class="param">
      <text class="label">工作小时</text>
      <text class="value">{{product.working_hours || '未填写'}} 小时</text>
    </view>
    <view class="param">
      <text class="label">所在地</text>
      <text class="value">{{product.location_province}}</text>
    </view>
    <view class="param">
      <text class="label">成色</text>
      <text class="value">{{product.condition_level}}成新</text>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="contact">
    <text class="label">联系方式</text>
    <view class="value">
      <text>{{product.contact_type === 'phone' ? '电话' : '微信'}}: {{product.contact_value || '暂无'}}</text>
      <button wx:if="{{product.contact_type === 'phone'}}" bindtap="callSeller">拨打电话</button>
      <button wx:else bindtap="copyContact">复制微信</button>
    </view>
  </view>

  <!-- 卖家信息 -->
  <view class="seller">
    <text>卖家：{{product.seller_username}}</text>
    <text>发布时间：{{product.created_at | formatDate}}</text>
  </view>
  
  <!-- 底部固定操作栏 -->
  <view class="fixed-bottom">
    <view class="price">¥{{product.price}}</view>
    <button class="buy-btn" bindtap="buyNow">立即购买</button>
  </view>
</view>
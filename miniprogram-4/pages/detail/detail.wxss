.container { background: #f5f5f5; min-height: 100vh; padding-bottom: 120rpx; }

swiper { height: 600rpx; display: block; }
swiper-item image { width: 100%; height: 600rpx; display: block; }

.info-bar { padding: 30rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.price { font-size: 56rpx; color: #ff5000; font-weight: bold; }
.title { font-size: 40rpx; font-weight: bold; margin-top: 20rpx; }

.params { background: #fff; padding: 30rpx; }
.param { display: flex; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 32rpx; }
.label { color: #666; }
.value { color: #333; font-weight: bold; }

.contact-section, .seller-section, .description-section { background: #fff; margin-top: 20rpx; padding: 30rpx; }
.section-title { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; display: block; }
.contact-item { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; }
.contact-item button { margin-left: 20rpx; border-radius: 50rpx; }

.seller-info text { display: block; margin: 10rpx 0; color: #666; }

.description { color: #333; line-height: 48rpx; white-space: pre-wrap; }

button { background: #ff5000; color: #fff; border-radius: 50rpx; }
.fixed-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.price { font-size: 48rpx; color: #ff5000; font-weight: bold; }
.buy-btn { background: #ff5000; color: #fff; border-radius: 50rpx; width: 300rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 36rpx; }
/* 标题与收藏区域 */
.title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.title-price {
  flex: 1;
}

.favorite-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 24rpx;
  padding: 10rpx;
  min-width: 100rpx;
}

.favorite-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 8rpx;
}

.favorite-text {
  font-size: 24rpx;
}
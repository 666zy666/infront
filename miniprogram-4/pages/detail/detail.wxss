.container { background: #f5f5f5; min-height: 100vh; }

.swiper { height: 600rpx; }
.swiper image { width: 100%; height: 100%; }

.price-bar {
  padding: 30rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}
.price { font-size: 56rpx; color: #ff5000; font-weight: bold; }
.favorite { font-size: 32rpx; color: #999; display: flex; align-items: center; }

.title {
  padding: 30rpx;
  font-size: 40rpx;
  font-weight: bold;
  background: #fff;
}

.specs {
  background: #fff;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}
.spec-item {
  display: flex;
  justify-content: space-between;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}
.label { color: #999; }
.value { color: #333; font-weight: bold; }

.seller {
  padding: 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
}
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 20rpx; }
.name { font-weight: bold; }
.date { color: #999; font-size: 28rpx; display: block; margin-top: 10rpx; }

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.btn {
  flex: 1;
  margin: 10rpx;
  border-radius: 50rpx;
  line-height: 80rpx;
}
.share { background: #fff; color: #333; }
.call { background: #ff5000; color: #fff; }
.container {
  background: #f0f2f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.search-input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.clear-btn {
  color: #999;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.search-btn {
  background: #1a1a2e;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  line-height: 1.4;
}

/* Mock 提示 */
.mock-tip {
  background: #fff3cd;
  color: #856404;
  font-size: 26rpx;
  padding: 20rpx 30rpx;
  margin: 20rpx 30rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid #ffc107;
}

/* 统计行 */
.list-header {
  padding: 20rpx 30rpx;
}

.count-text {
  font-size: 28rpx;
  color: #666;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 用户列表 */
.user-list {
  padding: 0 30rpx;
}

.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.user-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a1a2e, #0f3460);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar-letter {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  text-transform: uppercase;
}

.user-info {
  flex: 1;
  overflow: hidden;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.username {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.admin-badge {
  background: #1a1a2e;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.user-meta {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #bbb;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #bbb;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.loading-more-text {
  color: #999;
  font-size: 28rpx;
}

.load-more-btn {
  color: #1296db;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  display: inline-block;
}

.no-more-text {
  color: #ccc;
  font-size: 26rpx;
}

.container {
  background: #f0f2f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.search-input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.clear-btn {
  color: #999;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.search-btn {
  background: #1a1a2e;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  line-height: 1.4;
}

/* 统计行 */
.list-header {
  padding: 20rpx 30rpx;
}

.count-text {
  font-size: 28rpx;
  color: #666;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 商品列表 */
.product-list {
  padding: 0 30rpx;
}

.product-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.product-info {
  flex: 1;
  overflow: hidden;
}

.product-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  gap: 12rpx;
}

.title-row .product-title {
  flex: 1;
  margin-bottom: 0;
}

.status-badge {
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff5000;
  display: block;
  margin-bottom: 8rpx;
}

.product-seller, .product-time {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

/* 操作按钮 */
.product-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  line-height: 1.4;
  border: none;
}

.edit-btn {
  background: #1296db;
  color: #fff;
}

.delete-btn {
  background: #fff;
  color: #ff5000;
  border: 2rpx solid #ff5000;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #bbb;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #bbb;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.loading-more-text {
  color: #999;
  font-size: 28rpx;
}

.load-more-btn {
  color: #1296db;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  display: inline-block;
}

.no-more-text {
  color: #ccc;
  font-size: 26rpx;
}

.container {
  background: #f0f2f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.search-input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.clear-btn {
  color: #999;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.search-btn {
  background: #1a1a2e;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  line-height: 1.4;
}

/* 状态 Tab */
.tab-bar {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-list {
  display: inline-flex;
  padding: 0 10rpx;
}

.tab-item {
  display: inline-block;
  padding: 26rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  white-space: nowrap;
}

.tab-item.active {
  color: #1a1a2e;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #1a1a2e;
  border-radius: 4rpx;
}

/* 统计行 */
.list-header {
  padding: 20rpx 30rpx;
}

.count-text {
  font-size: 28rpx;
  color: #666;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 订单列表 */
.order-list {
  padding: 0 30rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
}

.product-row {
  display: flex;
  padding: 22rpx 28rpx;
  align-items: flex-start;
}

.product-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #f5f5f5;
}

.product-info {
  flex: 1;
  overflow: hidden;
}

.product-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.order-buyer, .order-seller, .order-time {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

.order-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff5000;
  display: block;
  margin-bottom: 6rpx;
}

/* 操作 */
.actions {
  padding: 18rpx 28rpx 22rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  font-size: 26rpx;
  padding: 12rpx 30rpx;
  border-radius: 50rpx;
  line-height: 1.4;
  border: none;
}

.detail-btn {
  background: #fff;
  color: #1296db;
  border: 2rpx solid #1296db;
}

.cancel-btn {
  background: #fff;
  color: #ff5000;
  border: 2rpx solid #ff5000;
}

.complete-btn {
  background: #07c160;
  color: #fff;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #bbb;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #bbb;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

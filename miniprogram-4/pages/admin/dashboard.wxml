<view class="container">
  <!-- 顶部 Banner -->
  <view class="header-banner">
    <view class="header-title">🛠️ 管理后台</view>
    <view class="header-sub">二手机械交易平台 · 后台管理</view>
  </view>

  <!-- Mock 数据提示 -->
  <view wx:if="{{stats.isMock}}" class="mock-tip">
    <text>⚠️ 用户数据为示例数据（后端用户管理接口未就绪）</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="section-title">数据总览</view>
    <view wx:if="{{loading}}" class="loading-text">加载中...</view>
    <view wx:else class="stats-grid">
      <view class="stat-card" bindtap="toUsers">
        <view class="stat-icon">👥</view>
        <view class="stat-num">{{stats.userCount}}</view>
        <view class="stat-label">用户总数</view>
      </view>
      <view class="stat-card" bindtap="toProducts">
        <view class="stat-icon">📦</view>
        <view class="stat-num">{{stats.productCount}}</view>
        <view class="stat-label">商品总数</view>
      </view>
      <view class="stat-card" bindtap="toOrders">
        <view class="stat-icon">🛒</view>
        <view class="stat-num">{{stats.orderCount}}</view>
        <view class="stat-label">订单总数</view>
      </view>
      <view class="stat-card">
        <view class="stat-icon">💰</view>
        <view class="stat-num">{{stats.totalSales !== '--' ? '¥' + stats.totalSales : '--'}}</view>
        <view class="stat-label">交易总额</view>
      </view>
    </view>
  </view>

  <!-- 快速入口 -->
  <view class="nav-section">
    <view class="section-title">功能入口</view>
    <view class="nav-grid">
      <view class="nav-item" bindtap="toUsers">
        <view class="nav-icon users-icon">👥</view>
        <view class="nav-label">用户管理</view>
        <view class="nav-desc">查看/搜索用户</view>
      </view>
      <view class="nav-item" bindtap="toProducts">
        <view class="nav-icon products-icon">📦</view>
        <view class="nav-label">商品管理</view>
        <view class="nav-desc">商品增删改查</view>
      </view>
      <view class="nav-item" bindtap="toOrders">
        <view class="nav-icon orders-icon">🛒</view>
        <view class="nav-label">订单管理</view>
        <view class="nav-desc">订单状态管理</view>
      </view>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="recent-section">
    <view class="section-title">最近订单</view>
    <view wx:if="{{recentOrders.length === 0}}" class="empty-tip">暂无订单数据</view>
    <block wx:for="{{recentOrders}}" wx:key="id">
      <view class="recent-order" bindtap="toOrderDetail" data-id="{{item.id}}">
        <view class="order-left">
          <view class="order-no">订单 #{{item.id}}</view>
          <view class="order-title ellipsis">{{item.product_title || item.product_name || '未知商品'}}</view>
          <view class="order-buyer">买家：{{item.buyer || item.buyer_username || '匿名'}}</view>
        </view>
        <view class="order-right">
          <view class="order-price">¥{{item.price || item.total_price}}</view>
          <view class="order-status" style="color: {{item._statusColor}}">{{item._statusText}}</view>
        </view>
      </view>
    </block>
    <view wx:if="{{recentOrders.length > 0}}" class="view-all" bindtap="toOrders">
      <text>查看全部订单 →</text>
    </view>
  </view>
</view>

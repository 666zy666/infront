<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <input
        class="search-input"
        placeholder="搜索商品名称 / 卖家"
        value="{{keyword}}"
        bindinput="inputKeyword"
        confirm-type="search"
        bindconfirm="search"
      />
      <text wx:if="{{keyword}}" class="clear-btn" bindtap="clearSearch">✕</text>
    </view>
    <button class="search-btn" bindtap="search">搜索</button>
  </view>

  <!-- 统计 -->
  <view class="list-header">
    <text class="count-text">共 {{products.length}} 件商品</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <!-- 商品列表 -->
  <view wx:else class="product-list">
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-card">
        <image
          src="{{item._imageUrl}}"
          class="product-thumb"
          mode="aspectFill"
          bindtap="toDetail"
          data-id="{{item.id}}"
        />
        <view class="product-info" bindtap="toDetail" data-id="{{item.id}}">
          <view class="title-row">
            <text class="product-title ellipsis">{{item.title || item.name || '未知商品'}}</text>
            <text class="status-badge" style="color:{{item._statusColor}}">{{item._statusText}}</text>
          </view>
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-seller">卖家：{{item.seller_username || item.seller || '匿名'}}</text>
          <text class="product-time">{{item.created_at || item.publish_time}}</text>
        </view>
        <view class="product-actions">
          <button class="action-btn edit-btn" bindtap="toEdit" data-id="{{item.id}}">编辑</button>
          <button
            class="action-btn delete-btn"
            bindtap="confirmDelete"
            data-id="{{item.id}}"
            data-title="{{item.title || item.name}}"
          >删除</button>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{products.length === 0}}" class="empty">
      <text class="empty-icon">📦</text>
      <text class="empty-text">{{keyword ? '未找到匹配商品' : '暂无商品数据'}}</text>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{products.length > 0}}" class="load-more">
      <view wx:if="{{loadingMore}}" class="loading-more-text">加载中...</view>
      <view wx:elif="{{hasMore}}" class="load-more-btn" bindtap="loadMore">加载更多</view>
      <view wx:else class="no-more-text">已显示全部商品</view>
    </view>
  </view>
</view>

<view class="container">
  <view class="title">创建账号</view>

  <view class="form">
    <input placeholder="设置用户名（6-20位）" bindinput="onUsernameInput" value="{{username}}" />
    <input placeholder="手机号（选填）" type="number" bindinput="onPhoneInput" value="{{phone}}" />
    <input placeholder="设置密码（至少6位）" password bindinput="onPasswordInput" />
    <input placeholder="再次输入密码" password bindinput="onPassword2Input" />

    <button type="primary" bindtap="register" loading="{{loading}}">立即注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text bindtap="toLogin" class="link">去登录</text>
    </view>
  </view>
</view>
.container { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.header { font-size: 36rpx; font-weight: bold; padding: 30rpx 0; text-align: center; background: #fff; margin-bottom: 20rpx; border-radius: 20rpx; }
.list { background: #fff; border-radius: 20rpx; overflow: hidden; }
.item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.item:last-child { border-bottom: none; }
.item image { width: 200rpx; height: 200rpx; border-radius: 20rpx; margin-right: 30rpx; }
.info { flex: 1; }
.title { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.price { color: #ff5000; font-size: 36rpx; font-weight: bold; display: block; margin-bottom: 10rpx; }
.location { color: #999; font-size: 28rpx; }
button { margin-top: 20rpx; border-radius: 50rpx; }
.empty { text-align: center; padding: 200rpx 0; color: #999; }
.empty image { width: 400rpx; }
.loading { text-align: center; padding: 200rpx 0; color: #999; }
.error-input {
  border: 2rpx solid #ff4d4f !important;
  background: #fff5f5 !important;
}

.error-text {
  color: #ff4d4f;
  font-size: 26rpx;
  margin-top: 8rpx;
  display: block;
}

.error-bar {
  background: #fff2f0;
  color: #ff4d4f;
  padding: 20rpx;
  text-align: center;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  border-radius: 12rpx;
}

.form-group {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}
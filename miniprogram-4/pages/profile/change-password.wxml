<view class="container">
  <!-- 顶部警告条 -->
  <view wx:if="{{showErrorBar}}" class="error-bar">
    <text>⚠️ {{globalError}}</text>
  </view>

  <!-- 旧密码 -->
  <view class="form-group {{error.oldPassword ? 'error-input' : ''}}">
    <text class="label">旧密码</text>
    <input 
      password 
      value="{{oldPassword}}" 
      bindinput="inputChange" 
      data-field="oldPassword" 
      placeholder="请输入旧密码" 
      focus="{{focusOldPassword}}"
    />
    <view class="error-line">
      <text class="error-text">{{error.oldPassword}}</text>
    </view>
  </view>

  <!-- 新密码 -->
  <view class="form-group {{error.newPassword ? 'error-input' : ''}}">
    <text class="label">新密码</text>
    <input 
      password 
      value="{{newPassword}}" 
      bindinput="inputChange" 
      data-field="newPassword" 
      placeholder="请输入新密码（至少8位）" 
    />
    <view class="error-line">
      <text class="error-text">{{error.newPassword}}</text>
    </view>
  </view>

  <!-- 确认新密码 -->
  <view class="form-group {{error.confirmPassword ? 'error-input' : ''}}">
    <text class="label">确认新密码</text>
    <input 
      password 
      value="{{confirmPassword}}" 
      bindinput="inputChange" 
      data-field="confirmPassword" 
      placeholder="请再次输入新密码" 
    />
    <view class="error-line">
      <text class="error-text">{{error.confirmPassword}}</text>
    </view>
  </view>

  <button class="save-btn" bindtap="changePassword" loading="{{saving}}">确认修改密码</button>
</view>
.avatar-section {
  text-align: center;
  margin: 40rpx 0;
  position: relative;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.upload-tip {
  margin-top: 20rpx;
  color: #1296db;
  font-size: 28rpx;
}

.disabled-input {
  background: #f5f5f5;
  color: #999;
}

.admin-tip {
  color: #ff9800;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx 20rpx 60rpx;
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}

.form-group .label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.form-group input {
  font-size: 32rpx;
  color: #333;
  width: 100%;
  border: none;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 12rpx;
  background: transparent;
}

.save-btn {
  width: 100%;
  background: #1296db;
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 24rpx;
  margin-top: 30rpx;
}
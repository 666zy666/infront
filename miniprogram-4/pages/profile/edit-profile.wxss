.container {
  padding: 40rpx 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.form-group {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.disabled-input {
  background: #f5f5f5;
  color: #999;
}

.save-btn {
  background: #ff5000;
  color: white;
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  margin-top: 40rpx;
}
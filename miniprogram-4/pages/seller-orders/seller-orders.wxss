.container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.header {
  padding: 40rpx 30rpx;
  background: white;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.total {
  font-size: 28rpx;
  color: #666;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.product-info {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  margin-right: 30rpx;
}

.detail {
  flex: 1;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.buyer, .price {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin: 10rpx 0;
}

.status-bar {
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
}

.status {
  font-size: 30rpx;
  font-weight: bold;
}

.status.PENDING_PAYMENT { color: #fa8c16; }
.status.PENDING_RECEIPT { color: #1296db; }
.status.COMPLETED { color: #07c160; }
.status.CANCELLED { color: #999999; }

.time {
  font-size: 28rpx;
  color: #999;
}

.actions {
  padding: 30rpx;
  background: #fff;
}

.ship-form {
  display: flex;
  flex-direction: column;
}

.ship-form input {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.ship-btn, .complete-btn, .cancel-btn {
  background: #1890ff;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.complete-btn {
  background: #52c41a;
}

.cancel-btn {
  background: #f5222d;
}

.no-action {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  padding: 30rpx;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

.empty image {
  width: 400rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}
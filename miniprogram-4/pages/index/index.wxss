/* pages/index/index.wxss */
.header {
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.publish-btn {
  margin-left: 20rpx;
  background: #ff5000;
  color: #fff;
  border-radius: 50rpx;
  padding: 0 40rpx;
  font-size: 32rpx;
}

.banner-img {
  width: 100%;
  height: 360rpx;
}

.banner-title {
  position: absolute;
  bottom: 20rpx;
  left: 30rpx;
  color: white;
  font-size: 36rpx;
  background: rgba(0,0,0,0.4);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  background: #fff;
}
.cat-item {
  width: 25%;
  text-align: center;
  margin-bottom: 40rpx;
}
.cat-item .icon {
  width: 100rpx;
  height: PEN100rpx;
}
.cat-item text {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
}

.product-waterfall {
  display: flex;
  padding: 20rpx;
}
.column { flex: 1; }
.product-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 10rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.product-card image {
  width: 100%;
  height: 100%;
}
.info {
  padding: 20rpx;
}
.title {
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price {
  color: #ff5000;
  font-size: 40rpx;
  font-weight: bold;
}
.tags {
  margin: 16rpx 0;
}
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}
.location {
  color: #999;
  font-size: 28rpx;
}

.empty, .loading, .no-more {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
.empty image { width: 400rpx; }
.search-entry {
  margin: 20rpx 30rpx;
  padding: 20rpx 30rpx;
  background: white;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.search-text {
  color: #999;
  font-size: 30rpx;
  margin-left: 20rpx;
}
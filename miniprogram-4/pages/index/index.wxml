<view class="container">

<!-- 顶部搜索-->
<navigator url="/pages/search/search" hover-class="none">
  <view class="search-entry">
    <icon type="search" size="40" color="#999" />
    <text class="search-text">搜索设备、品牌、型号...</text>
  </view>
</navigator>

<!-- 轮播图 -->
<swiper 
  indicator-dots="{{indicatorDots}}" 
  autoplay="{{autoplay}}" 
  interval="{{interval}}" 
  duration="{{duration}}" 
  circular="{{circular}}"
>
  <block wx:for="{{banners}}" wx:key="id">
    <swiper-item bindtap="onBannerTap" data-banner="{{item}}">
      <image 
        src="{{item.image}}" 
        mode="aspectFill" 
        class="banner-img"
      />
      <!-- 可选标题 -->
      <view class="banner-title" wx:if="{{item.title}}">{{item.title}}</view>
    </swiper-item>
  </block>

  <!-- 无轮播图占位 -->
  <block wx:if="{{!banners || banners.length === 0}}">
    <swiper-item>
      <image src="/images/banner-placeholder.jpg" mode="aspectFill" class="banner-img" />
    </swiper-item>
  </block>
</swiper>

<!-- 分类导航 -->
<view class="category-section">
  <text class="section-title">设备分类</text>
  <view class="category-grid">
    <block wx:for="{{categories}}" wx:key="name">
      <view class="category-item" bindtap="toCategory" data-index="{{index}}">
        <image src="{{item.icon}}" mode="aspectFit" class="cat-icon" />
        <text>{{item.name}}</text>
      </view>
    </block>
  </view>
</view>

<!-- 商品瀑布流 -->
<view class="product-waterfall">
  <view class="column">
    <block wx:for="{{products}}" wx:for-item="item" wx:key="id" wx:if="{{index % 2 === 0}}">
      <view class="product-card" bindtap="toDetail" data-id="{{item.id}}">
        <image 
  src="{{item.images && item.images[0] && item.images[0].image || '/images/default.jpg'}}"
  mode="aspectFill" 
/>
        <view class="info">
          <text class="title">{{item.title}}</text>
          <text class="price">¥{{item.price}}</text>
          <view class="tags">
            <text class="tag">{{item.brand}}</text>
            <text class="tag">{{item.condition_level}}成新</text>
            <text class="tag">{{item.working_hours || 0}}h</text>
          </view>
          <text class="location">{{item.location_province}} · {{item.location_city}}</text>
        </view>
      </view>
    </block>
  </view>
  <view class="column">
    <block wx:for="{{products}}" wx:for-item="item" wx:key="id" wx:if="{{index % 2 === 1}}">
      <view class="product-card" bindtap="toDetail" data-id="{{item.id}}">
        <image 
  src="{{item.images && item.images[0] && item.images[0].image || '/images/default.jpg'}}"
  mode="aspectFill" 
/>
        <view class="info">
          <text class="title">{{item.title}}</text>
          <text class="price">¥{{item.price}}</text>
          <view class="tags">
            <text class="tag">{{item.brand}}</text>
            <text class="tag">{{item.condition_level}}成新</text>
            <text class="tag">{{item.working_hours || 0}}h</text>
          </view>
          <text class="location">{{item.location_province}} · {{item.location_city}}</text>
        </view>
      </view>
    </block>
  </view>
</view>

<!-- 空状态 -->
<view wx:if="{{showEmpty}}" class="empty">
  <image src="/images/empty.png" mode="widthFix" />
  <text>暂无设备发布~</text>
</view>

<!-- 加载提示 -->
<view wx:if="{{loading && products.length > 0}}" class="loading">加载中...</view>
<view wx:if="{{!hasMore && products.length > 0}}" class="no-more">没有更多了</view>

</view>
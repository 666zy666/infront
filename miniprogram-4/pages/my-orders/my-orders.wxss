.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Tab 栏 */
.tab-bar {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-list {
  display: inline-flex;
  padding: 0 10rpx;
}

.tab-item {
  display: inline-block;
  padding: 28rpx 36rpx;
  font-size: 30rpx;
  color: #666;
  position: relative;
  white-space: nowrap;
}

.tab-item.active {
  color: #1296db;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #1296db;
  border-radius: 4rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
}

/* 商品区 */
.product {
  display: flex;
  padding: 24rpx 30rpx;
  align-items: flex-start;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.info {
  flex: 1;
  overflow: hidden;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.seller, .price, .time {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.price {
  color: #ff5000;
  font-size: 30rpx;
  font-weight: bold;
}

/* 操作按钮区 */
.actions {
  padding: 20rpx 30rpx 24rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.btn {
  font-size: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 50rpx;
  line-height: 1.4;
  border: none;
}

.btn-pay {
  background: #1296db;
  color: #fff;
}

.btn-cancel {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}

.btn-confirm {
  background: #07c160;
  color: #fff;
}

.btn-detail {
  background: #fff;
  color: #1296db;
  border: 2rpx solid #1296db;
}

.btn-home {
  margin-top: 30rpx;
  background: #1296db;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 160rpx 0 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  display: block;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

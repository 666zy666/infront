<view class="container">
  <!-- Tab 栏 -->
  <scroll-view class="tab-bar" scroll-x="true">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{currentTab === index ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="{{index}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card">
        <!-- 状态行 -->
        <view class="card-header">
          <text class="order-no">订单号：{{item.id}}</text>
          <text class="order-status" style="color:{{item._statusColor}}">{{item._statusText}}</text>
        </view>

        <!-- 商品信息 -->
        <view class="product" bindtap="toOrderDetail" data-id="{{item.id}}">
          <image
            src="{{item.product_image || '/images/cat/all.png'}}"
            mode="aspectFill"
            class="thumb"
          />
          <view class="info">
            <text class="title ellipsis">{{item.product_title || item.product_name || '商品'}}</text>
            <text class="seller">卖家：{{item.seller_username || item.seller || '匿名'}}</text>
            <text class="price">¥{{item.price || item.total_price}}</text>
            <text class="time">{{item.created_at}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="actions">
          <!-- 待付款：支付 + 取消 -->
          <block wx:if="{{item._status === 'PENDING_PAYMENT'}}">
            <button class="btn btn-cancel" bindtap="handleCancel" data-id="{{item.id}}">取消订单</button>
            <button class="btn btn-pay" bindtap="handlePay" data-id="{{item.id}}">立即支付</button>
          </block>

          <!-- 待收货：确认收货 -->
          <block wx:elif="{{item._status === 'PENDING_RECEIPT'}}">
            <button class="btn btn-confirm" bindtap="handleConfirm" data-id="{{item.id}}">确认收货</button>
          </block>

          <!-- 其他：查看详情 -->
          <block wx:else>
            <button class="btn btn-detail" bindtap="toOrderDetail" data-id="{{item.id}}">查看详情</button>
          </block>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{!orders.length && !loading}}" class="empty">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单记录</text>
      <button class="btn btn-home" bindtap="goHome">去首页逛逛</button>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>
  </view>
</view>

<view class="container" wx:if="{{!loading && order}}">
  <!-- 状态卡片 -->
  <view class="status-card">
    <text class="status-text" style="color:{{order._statusColor}}">{{order._statusText}}</text>
    <text class="order-no">订单号：{{order.id}}</text>
    <text class="order-time">下单时间：{{order.created_at}}</text>
  </view>

  <!-- 商品信息 -->
  <view class="section">
    <view class="section-title">商品信息</view>
    <view class="product-row">
      <image src="{{order.product_image || '/images/cat/all.png'}}" class="thumb" mode="aspectFill" />
      <view class="product-info">
        <text class="product-title">{{order.product_title || order.product_name || '商品'}}</text>
        <text class="product-price">¥{{order.price || order.total_price}}</text>
        <text class="product-seller">卖家：{{order.seller_username || order.seller || '匿名'}}</text>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="section" wx:if="{{order.shipping_address || order.address}}">
    <view class="section-title">收货地址</view>
    <view class="address-row">
      <text class="address-name">{{order.recipient_name || order.address_name}}</text>
      <text class="address-phone">{{order.recipient_phone || order.address_phone}}</text>
      <text class="address-detail">{{order.shipping_address || order.address}}</text>
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="section">
    <view class="section-title">金额明细</view>
    <view class="amount-row">
      <text class="amount-label">商品总价</text>
      <text class="amount-value">¥{{order.price || order.total_price}}</text>
    </view>
    <view class="amount-row total">
      <text class="amount-label">实付金额</text>
      <text class="amount-total">¥{{order.price || order.total_price}}</text>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>

<!-- 空/错误 -->
<view class="empty" wx:if="{{!loading && !order}}">
  <text>订单不存在或加载失败</text>
  <button class="btn-back" bindtap="goBack">返回</button>
</view>

<!-- 底部操作按钮 -->
<view class="footer" wx:if="{{!loading && order}}">
  <block wx:if="{{order._status === 'PENDING_PAYMENT'}}">
    <button class="btn btn-cancel" bindtap="handleCancel" disabled="{{operating}}">取消订单</button>
    <button class="btn btn-pay" bindtap="handlePay" disabled="{{operating}}">立即支付</button>
  </block>
  <block wx:elif="{{order._status === 'PENDING_RECEIPT'}}">
    <button class="btn btn-confirm" bindtap="handleConfirm" disabled="{{operating}}">确认收货</button>
  </block>
  <block wx:else>
    <button class="btn btn-back-plain" bindtap="goBack">返回</button>
  </block>
</view>

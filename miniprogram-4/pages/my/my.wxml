<view class="container">
  <!-- 用户信息 -->

<view class="user-card">
  <image 
    src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
    class="avatar" 
    mode="aspectFill" 
  />
  <view class="user-info">
    <text class="nickname">{{userInfo.nickName || userInfo.username || '未登录用户'}}</text>
    <text class="welcome">欢迎回来</text>
  </view>
  <button 
    wx:if="{{!hasLogin}}" 
    class="login-btn" 
    bindtap="toLogin"
  >立即登录</button>
  <button 
    wx:else 
    class="logout-btn" 
    bindtap="logout"
  >退出登录</button>
</view>

  <!-- 统计网格 -->
  <view class="stats-grid">
    <view class="stat-item" bindtap="toMyPublish">
      <text class="num">{{stats.published || 0}}</text>
      <text class="label">我的发布</text>
    </view>
    <view class="stat-item" bindtap="toMyFavorites">
      <text class="num">{{stats.favorites || 0}}</text>
      <text class="label">我的收藏</text>
    </view>
    <view class="stat-item" bindtap="toMyOrders">
      <text class="num">{{stats.orders || 0}}</text>
      <text class="label">我的订单</text>
    </view>
    <view class="stat-item" bindtap="toSellerOrders">
      <text class="num">{{stats.sellerOrders || 0}}</text>
      <text class="label">待处理订单</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" hover-class="hover" bindtap="toMyPublish">
      <icon type="list" size="56" color="#1989fa" />
      <text>我的发布</text>
    </view>
    <view class="menu-item" hover-class="hover" bindtap="toMyFavorites">
      <icon type="favorfill" size="56" color="#ff5000" />
      <text>我的收藏</text>
    </view>
    <view class="menu-item" hover-class="hover" bindtap="toMyOrders">
      <icon type="order" size="56" color="#07c160" />
      <text>我的订单</text>
    </view>
    <view class="menu-item" hover-class="hover" bindtap="toSellerOrders">
      <icon type="shop" size="56" color="#fa8c16" />
      <text>待处理订单</text>
    </view>

    <!-- 新增：个人信息编辑 -->
    <view class="menu-item" hover-class="hover" bindtap="editProfile">
      <icon type="profile" size="56" color="#07c160" />
      <text>个人信息</text>
    </view>

    <!-- 新增：修改密码 -->
    <view class="menu-item" hover-class="hover" bindtap="changePassword">
      <icon type="lock" size="56" color="#fa8c16" />
      <text>修改密码</text>
    </view>

    <view class="menu-item" hover-class="hover" bindtap="toSettings">
      <icon type="setting" size="56" color="#969799" />
      <text>设置</text>
    </view>
  </view>
</view>
/* pages/my/my.wxss */
.container { background: #f5f5f5; min-height: 100vh; }

.unlogin-card {
  background: #fff;
  padding: 80rpx 60rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.unlogin-card .avatar { width: 160rpx; height: 160rpx; border-radius: 50%; margin-right: 40rpx; }
.unlogin-card .text { text-align: left; }
.tip { font-size: 36rpx; color: #333; display: block; margin-bottom: 20rpx; }
.login-btn { color: #1296db; font-size: 36rpx; font-weight: bold; }

.user-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 80rpx 60rpx;
  color: #fff;
  display: flex;
  align-items: center;
}
.user-card .avatar { width: 160rpx; height: 160rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,0.3); margin-right: 40rpx; }
.nickname { font-size: 44rpx; font-weight: bold; }
.welcome { font-size: 28rpx; opacity: 0.9; margin-top: 10rpx; display: block; }
.logout-btn { margin-left: auto; background: rgba(255,255,255,0.3); color: #fff; }

.stats-grid {
  display: flex;
  background: #fff;
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.stat-item {
  flex: 1;
  padding: 40rpx 0;
  text-align: center;
}
.num { font-size: 48rpx; font-weight: bold; color: #333; display: block; }
.label { font-size: 28rpx; color: #999; }

.menu-list {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.menu-item {
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-item .label { font-size: 32rpx; }
.version { color: #999; font-size: 28rpx; }
.active { background: #f9f9f9; }
.container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 40rpx 60rpx;
  color: white;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.4);
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 48rpx;
  font-weight: bold;
}

.welcome {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 10rpx;
  display: block;
}

.login-btn, .logout-btn {
  background: rgba(255,255,255,0.25);
  color: white;
  border: 2rpx solid white;
  border-radius: 50rpx;
  padding: 10rpx 40rpx;
  font-size: 28rpx;
  line-height: 1;
}

/* 统计网格 */
.stats-grid {
  margin: 0 30rpx 30rpx;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 0;
  display: flex;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-item .num {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.stat-item .label {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
}

/* 功能菜单 */
.menu-list {
  margin: 0 30rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.menu-item {
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  color: #333;
  font-size: 34rpx;
  transition: all 0.2s;
}

.menu-item:hover, .menu-item.hover {
  background: #f8f9fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item icon {
  margin-right: 36rpx;
  width: 70rpx;
  text-align: center;
}
/* 管理员后台入口 */
.admin-item {
  background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);
  color: #fff;
  border-bottom: none;
}

.admin-item text {
  color: #fff;
}

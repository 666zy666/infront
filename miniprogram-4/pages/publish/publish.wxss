/* pages/publish/publish.wxss */
.container { background: #f5f5f5; min-height: 100vh; }

.image-section {
  background: #fff;
  padding: 30rpx;
}
.image-grid {
  display: flex;
  flex-wrap: wrap;
}
.image-item {
  position: relative;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}
.image-item image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}
.delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  padding: 10rpx;
}
.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ccc;
}
.tip { color: #999; font-size: 28rpx; margin-top: 20rpx; }

.form-section {
  margin-top: 20rpx;
  background: #fff;
  padding: 0 30rpx;
}
.title-input {
  font-size: 40rpx;
  font-weight: bold;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}
.price-input {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}
.price-input .symbol {
  font-size: 48rpx;
  color: #ff5000;
  margin-right: 10rpx;
}
.price-input input {
  font-size: 60rpx;
  font-weight: bold;
  color: #ff5000;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
}
.label { font-weight: bold; margin-bottom: 20rpx; }
.required { color: #ff5000; }
.types, .conditions {
  display: flex;
  flex-wrap: wrap;
}
.type-tag, .tag {
  padding: 16rpx 32rpx;
  margin: 10rpx 20rpx 10rpx 0;
  border: 1rpx solid #ddd;
  border-radius: 50rpx;
  font-size: 30rpx;
}
.type-tag.active, .tag.active {
  background: #e3f2fd;
  border-color: #1296db;
  color: #1296db;
}

.picker {
  padding: 20rpx 0;
  color: #1296db;
}

.description {
  height: 300rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin: 30rpx 0;
}

.submit-btn {
  margin: 60rpx 0;
  border-radius: 50rpx;
  font-size: 36rpx;
}
.full-input {
  width: 100%;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-top: 20rpx;
}
.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}
.container { background: #f5f5f5; min-height: 100vh; padding-bottom: 200rpx; }

.image-section { padding: 30rpx; background: #fff; margin-bottom: 20rpx; }
.image-grid { display: flex; flex-wrap: wrap; }
.image-item { width: 200rpx; height: 200rpx; margin: 10rpx; position: relative; }
.image-item image { width: 100%; height: 100%; border-radius: 10rpx; }
.delete { position: absolute; top: -10rpx; right: -10rpx; background: rgba(0,0,0,0.6); border-radius: 50%; padding: 5rpx; }
.upload-btn { width: 200rpx; height: 200rpx; margin: 10rpx; background: #f8f8f8; border: 2rpx dashed #ddd; border-radius: 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.upload-btn text { font-size: 28rpx; color: #999; margin-top: 10rpx; }
.tip { font-size: 28rpx; color: #999; display: block; margin-top: 20rpx; text-align: center; }

.form-section { background: #fff; padding: 30rpx; }
.form-item { margin-bottom: 40rpx; }
.label { font-size: 32rpx; color: #333; display: block; margin-bottom: 20rpx; }
.required { color: #ff5000; }
.title-input { border-bottom: 1rpx solid #eee; padding: 20rpx 0; font-size: 36rpx; }
.price-input { display: flex; align-items: center; border-bottom: 1rpx solid #eee; padding: 20rpx 0; }
.symbol { font-size: 48rpx; color: #ff5000; margin-right: 20rpx; }
input { flex: 1; font-size: 36rpx; }

.types { display: flex; flex-wrap: wrap; }
.type-tag { padding: 10rpx 30rpx; margin: 10rpx; background: #f0f0f0; border-radius: 50rpx; font-size: 28rpx; color: #666; }
.type-tag.active { background: #ffebee; color: #ff5000; border: 1rpx solid #ff5000; }

.conditions { display: flex; flex-wrap: wrap; }
.tag { padding: 10rpx 30rpx; margin: 10rpx; background: #f0f0f0; border-radius: 50rpx; font-size: 28rpx; color: #666; }
.tag.active { background: #ffebee; color: #ff5000; border: 1rpx solid #ff5000; }

.contact-type { border: 1rpx solid #eee; border-radius: 10rpx; padding: 20rpx; margin-bottom: 20rpx; }
.picker { color: #333; }

.description { border: 1rpx solid #eee; border-radius: 10rpx; padding: 20rpx; height: 300rpx; margin-bottom: 40rpx; }

.submit-btn { background: #ff5000; color: #fff; border-radius: 50rpx; font-size: 36rpx; }